<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <ROS_DISTRO>lyrical</ROS_DISTRO>
      <ROS_LOCALHOST_ONLY>0</ROS_LOCALHOST_ONLY>
      <ROS_PYTHON_VERSION>3</ROS_PYTHON_VERSION>
      <ROS_VERSION>2</ROS_VERSION>
      <PATH>D:\sdk\ros\lyrical\bin</PATH>
      <AMENT_PREFIX_PATH>D:\sdk\ros\lyrical;</AMENT_PREFIX_PATH>
      <RMW_IMPLEMENTATION>rmw_fastrtps_cpp</RMW_IMPLEMENTATION>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
